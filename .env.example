# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini 3.8 Flash, Imagen, TTS, etc.)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (when running with Prisma/Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/shortsai"

# AUTH_SECRET: JWT or session secret for authentication
AUTH_SECRET="your-super-secret-jwt-key"

# Storage credentials (S3/Cloud Storage abstraction)
STORAGE_ENDPOINT="https://storage.googleapis.com"
STORAGE_ACCESS_KEY="MY_STORAGE_ACCESS_KEY"
STORAGE_SECRET_KEY="MY_STORAGE_SECRET_KEY"
STORAGE_BUCKET="shortsai-media"

# Optional external video and voice provider keys (e.g. Veo, ElevenLabs, Runway)
VIDEO_PROVIDER_API_KEY=""
VOICE_PROVIDER_API_KEY=""

# Razorpay credentials for Indian payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
